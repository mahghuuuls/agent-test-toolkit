{
  "v46_session": {
    "description": "Starts the v46 session and binds the caller as its operator, so ${operator.name} and fixture placeholders resolve. Run once per world, after v42_world_prepare. Expect V46_SESSION_READY.",
    "stopOnFailure": true,
    "commands": [
      "devtool session start v46_evidence",
      "devtool session operator @s",
      "devtool mark V46_SESSION_READY"
    ]
  },
  "v46_light": {
    "description": "Light in BLOCK_INSPECT (1.8.0). Run v43_platform first. Puts a torch on the floor at 2 100 2, then inspects the torch's own position (expect blockLight=14), the air one step away at 2 100 3 (expect blockLight=13), and air open to the sky at 0 104 0 (expect skyLight=15). Ends with V46_LIGHT_END; v46_light_cleanup removes the torch.",
    "stopOnFailure": true,
    "commands": [
      "devtool mark V46_LIGHT_BEGIN",
      {
        "command": "setblock 2 100 2 minecraft:torch",
        "toleratedFailures": [
          "commands.setblock.noChange"
        ]
      },
      {
        "command": "devtool inspect block 2 100 2",
        "delayTicks": 2
      },
      "devtool inspect block 2 100 3",
      "devtool inspect block 0 104 0",
      "devtool mark V46_LIGHT_END"
    ]
  },
  "v46_light_cleanup": {
    "description": "Removes v46_light's torch. Expect V46_LIGHT_CLEAN.",
    "commands": [
      {
        "command": "setblock 2 100 2 minecraft:air",
        "toleratedFailures": [
          "commands.setblock.noChange"
        ]
      },
      "devtool mark V46_LIGHT_CLEAN"
    ]
  },
  "v46_health": {
    "description": "The health assert (1.8.0). Run v46_session first. Survival with natural regeneration off for the bundle, so health does not change by itself; full health, then Resistance I and one instant damage: 6 magic damage reduced by a fifth to 4.8, health 15.2 (a fractional value). Expect ASSERT predicate=player.health outcome=pass for 20, then pass for 15.2, then outcome=fail for 20 (tolerated devtool.assert.failed), and PLAYER_INSPECT health=15.20 between. Restores regeneration, effects, health and creative at the end.",
    "stopOnFailure": true,
    "commands": [
      "devtool mark V46_HEALTH_BEGIN",
      "gamerule naturalRegeneration false",
      "gamemode survival",
      {
        "command": "effect @s clear",
        "toleratedFailures": [
          "commands.effect.failure.notActive.all"
        ]
      },
      "effect @s minecraft:instant_health 1 10 true",
      {
        "command": "devtool assert player ${operator.name} health 20",
        "delayTicks": 5
      },
      "effect @s minecraft:resistance 30 0 true",
      "effect @s minecraft:instant_damage 1 0 true",
      {
        "command": "devtool inspect player",
        "delayTicks": 5
      },
      "devtool assert player ${operator.name} health 15.2",
      {
        "command": "devtool assert player ${operator.name} health 20",
        "toleratedFailures": [
          "devtool.assert.failed"
        ]
      },
      {
        "command": "effect @s clear",
        "toleratedFailures": [
          "commands.effect.failure.notActive.all"
        ]
      },
      "effect @s minecraft:instant_health 1 10 true",
      {
        "command": "gamerule naturalRegeneration true",
        "delayTicks": 5
      },
      "gamemode creative",
      "devtool mark V46_HEALTH_END"
    ]
  },
  "v46_fixture_cleared": {
    "description": "A cleared fixture's placeholder (1.8.0). Run v46_session and v43_platform first. Summons a pig without AI, claims it as p46, clears it, then asserts the cleared handle's entity absent with no 'at': expect FIXTURE outcome=removed and ASSERT outcome=pass predicate entity.absent. Ends with V46_FIXTURE_END.",
    "stopOnFailure": true,
    "commands": [
      "devtool mark V46_FIXTURE_BEGIN",
      "kill @e[type=minecraft:pig,name=v46pig]",
      {
        "command": "summon minecraft:pig 0.5 100 3.5 {CustomName:\"v46pig\",NoAI:1b,PersistenceRequired:1b}",
        "delayTicks": 2
      },
      "devtool fixture claim p46 @e[name=v46pig]",
      {
        "command": "devtool fixture clear p46",
        "delayTicks": 2
      },
      {
        "command": "devtool assert entity ${fixture.p46.uuid} absent",
        "delayTicks": 5
      },
      "devtool mark V46_FIXTURE_END"
    ]
  },
  "v46_find_setup": {
    "description": "The scene for find block (1.8.0). Run v43_platform first. Three diamond blocks at -1, 0 and 1 100 3; three wooden doors, lower and upper halves: facing east at -2 100 0, facing north at 2 100 0, facing south at 2 100 4; one oak fence at -2 100 4. Expect V46_FIND_READY.",
    "stopOnFailure": true,
    "commands": [
      {
        "command": "setblock -1 100 3 minecraft:diamond_block",
        "toleratedFailures": [
          "commands.setblock.noChange"
        ]
      },
      {
        "command": "setblock 0 100 3 minecraft:diamond_block",
        "toleratedFailures": [
          "commands.setblock.noChange"
        ]
      },
      {
        "command": "setblock 1 100 3 minecraft:diamond_block",
        "toleratedFailures": [
          "commands.setblock.noChange"
        ]
      },
      {
        "command": "setblock -2 100 0 minecraft:wooden_door facing=east,half=lower",
        "toleratedFailures": [
          "commands.setblock.noChange"
        ]
      },
      {
        "command": "setblock -2 101 0 minecraft:wooden_door facing=east,half=upper,hinge=left",
        "toleratedFailures": [
          "commands.setblock.noChange"
        ]
      },
      {
        "command": "setblock 2 100 0 minecraft:wooden_door facing=north,half=lower",
        "toleratedFailures": [
          "commands.setblock.noChange"
        ]
      },
      {
        "command": "setblock 2 101 0 minecraft:wooden_door facing=north,half=upper,hinge=left",
        "toleratedFailures": [
          "commands.setblock.noChange"
        ]
      },
      {
        "command": "setblock 2 100 4 minecraft:wooden_door facing=south,half=lower",
        "toleratedFailures": [
          "commands.setblock.noChange"
        ]
      },
      {
        "command": "setblock 2 101 4 minecraft:wooden_door facing=south,half=upper,hinge=left",
        "toleratedFailures": [
          "commands.setblock.noChange"
        ]
      },
      {
        "command": "setblock -2 100 4 minecraft:fence",
        "toleratedFailures": [
          "commands.setblock.noChange"
        ]
      },
      {
        "command": "devtool inspect block -2 101 0",
        "delayTicks": 2
      },
      "devtool mark V46_FIND_READY"
    ]
  },
  "v46_find": {
    "description": "find block (1.8.0). Run v46_find_setup first. Expect: diamond_block found=3 truncated=false chunksSkipped=0; with limit 1 found=1 truncated=true; wooden_door facing=east found=1 (the lower half only: the upper halves store no facing); fence north=true refused devtool.find.badState (tolerated: the world does not store a fence's sides); a box far away with chunksSkipped above 0 and found=0, and CHUNK_INSPECT loaded=false there afterwards (nothing was loaded); a box of 38 by 38 chunks refused devtool.find.tooLarge (tolerated). Ends with V46_FIND_END.",
    "stopOnFailure": true,
    "commands": [
      "devtool mark V46_FIND_BEGIN",
      "devtool find block minecraft:diamond_block -2 99 -1 2 107 4",
      "devtool find block minecraft:diamond_block -2 99 -1 2 107 4 limit 1",
      "devtool find block minecraft:wooden_door facing=east -2 99 -1 2 107 4",
      {
        "command": "devtool find block minecraft:fence north=true -2 99 -1 2 107 4",
        "toleratedFailures": [
          "devtool.find.badState"
        ]
      },
      "devtool find block minecraft:diamond_block 3000 0 3000 3200 255 3200",
      "devtool inspect chunk 3000 3000",
      {
        "command": "devtool find block minecraft:stone 0 0 0 600 10 600",
        "toleratedFailures": [
          "devtool.find.tooLarge"
        ]
      },
      "devtool mark V46_FIND_END"
    ]
  },
  "v46_find_cleanup": {
    "description": "Clears v46_find_setup's blocks (the air above the v43 floor). Expect V46_FIND_CLEAN.",
    "commands": [
      {
        "command": "fill -2 100 -1 2 107 4 minecraft:air",
        "toleratedFailures": [
          "commands.fill.failed"
        ]
      },
      "devtool mark V46_FIND_CLEAN"
    ]
  },
  "v46_pickup": {
    "description": "item_pickup (1.8.0). Run v43_platform first. Survival; a stack of 5 dirt dropped at the feet: expect one ITEM_PICKUP count=5. Then an inventory full of stone with 62 dirt in its last slot and 5 dirt dropped: expect ITEM_PICKUP count=2 (the dirt stack fills to 64); a slot then freed: expect ITEM_PICKUP count=3 for the rest. INVENTORY_INSPECT after each. Turns the category off, clears the inventory and returns to creative at the end; V46_PICKUP_END.",
    "stopOnFailure": true,
    "commands": [
      "devtool mark V46_PICKUP_BEGIN",
      "devtool log item_pickup on",
      "gamemode survival",
      {
        "command": "clear @s",
        "toleratedFailures": [
          "commands.clear.failure"
