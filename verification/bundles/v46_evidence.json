  "v46_pause_book": {
    "description": "The pause note (1.8.0). Single player, development client with client.allowActions. Puts a book and quill in hotbar slot 5, selects it and uses it: the book screen opens and pauses the game. Expect CLIENT_ACTION step=use result=done and, while the book is open, config/devtool/inbox/paused.json with screen=net.minecraft.client.gui.GuiScreenBook. The person then closes the book (Esc): the note is removed. Nothing after the use runs until then, so the use is last.",
    "stopOnFailure": true,
    "commands": [
      "devtool mark V46_PAUSE_BEGIN",
      "gamemode creative",
      "replaceitem entity @s slot.hotbar.5 minecraft:writable_book",
      {
        "command": "devtool client select 5",
        "delayTicks": 5
      },
      {
        "command": "devtool client use",
        "delayTicks": 5
      }
    ]
  },
  "v46_pause_after": {
    "description": "After the pause card (1.8.0): opens the inventory, which does not pause (expect no paused.json while it is open), closes it, and puts the hotbar slot back to 0. Ends with V46_PAUSE_END.",
    "stopOnFailure": true,
    "commands": [
      "devtool client inventory",
      {
        "command": "devtool client close",
        "delayTicks": 40
      },
      {
        "command": "devtool client select 0",
        "delayTicks": 5
      },
      {
        "command": "replaceitem entity @s slot.hotbar.5 minecraft:air",
        "delayTicks": 5
      },
      "devtool mark V46_PAUSE_END"
    ]
  },
  "v46_screens": {
    "description": "Screenshots with hide (1.8.0), development client with the toolkit 1.8.0. Writes chat lines (marks), then four pictures: v46_nochat with hide=chat (expect no chat lines) and v46_plain 5 ticks later (expect chat lines and the HUD); v46_nohud with hide=hud (expect no hotbar, crosshair, chat or hand) and v46_after_hud 5 ticks later (expect the HUD back: F1 restored). SCREENSHOT records with hide; no Saved screenshot chat line naming v46_nochat or v46_nohud (the plain ones print theirs). Ends with V46_SCREENS_END.",
    "stopOnFailure": true,
    "commands": [
      "devtool mark V46_SCREENS_LINE_1",
      "devtool mark V46_SCREENS_LINE_2",
      {
        "command": "devtool screenshot v46_nochat 0 hide=chat",
        "delayTicks": 5
      },
      "devtool screenshot v46_plain 5",
      {
        "command": "devtool screenshot v46_nohud 0 hide=hud",
        "delayTicks": 20
      },
      "devtool screenshot v46_after_hud 5",
      {
        "command": "devtool mark V46_SCREENS_END",
        "delayTicks": 20
      }
    ]
  },
  "v46_screens_open": {
    "description": "hide=hud with a screen open (1.8.0): survival, so the inventory key opens the survival inventory (creative would open the creative one); opens it, takes v46_inv_nohud with hide=hud (expect the inventory drawn and the HUD behind it, chat, hand and block outline left out; the SCREENSHOT record names net.minecraft.client.gui.inventory.GuiInventory), closes it, back to creative. Ends with V46_SCREENS_OPEN_END.",
    "stopOnFailure": true,
    "commands": [
      "gamemode survival",
      {
        "command": "devtool client inventory",
        "delayTicks": 5
      },
      {
        "command": "devtool screenshot v46_inv_nohud 0 hide=hud",
        "delayTicks": 10
      },
      {
        "command": "devtool client close",
        "delayTicks": 10
      },
      {
        "command": "gamemode creative",
        "delayTicks": 5
      },
      "devtool mark V46_SCREENS_OPEN_END"
    ]
  },
  "v46_populated": {
    "description": "Waiting for decorated chunks (1.8.0). Run in a flat forest world with decoration (create ... type=flat structures=false flat=3;minecraft:bedrock,2*minecraft:dirt,minecraft:grass;4;decoration), where trees grow in every chunk: grass at y 3, trees above. Moves the caller to a fresh area at 3000.5 40 3000.5 in creative; the plain wait for loaded chunks; CHUNK_INSPECT right after it of the +X+Z corner chunk at 3032 3032 and the -X ring chunk at 2950 2950, whose decoration the plain wait does not guarantee (observed either way: terrainPopulated=false there shows the gap the populated wait closes); the wait with populated (expect populated=true; its waitedTicks says how long decoration still ran); a search of the box 3000 4 3000 3010 30 3010 for leaves and logs (expect found above 0: trees are there); the box cleared to air; 200 ticks later the same searches (expect found=0 for leaves, logs, leaves2 and log2: nothing decorated into it afterwards); then a populated wait over a rectangle reaching the loaded area's edge east of the caller with a short timeout (expect AWAIT outcome=timedOut naming firstUnpopulatedChunk, tolerated devtool.wait.timeout), and CHUNK_INSPECT eastward. Ends with V46_POPULATED_END.",
    "stopOnFailure": true,
    "commands": [
      "devtool mark V46_POPULATED_BEGIN",
      "gamemode creative",
      "tp @s 3000.5 40 3000.5 0 0",
      {
        "command": "devtool await chunks ~-32 ~-32 ~32 ~32 1200",
        "delayTicks": 1
      },
      "devtool inspect chunk 3032 3032",
      "devtool inspect chunk 2950 2950",
      "devtool await chunks ~-32 ~-32 ~32 ~32 1200 populated",
      "devtool find block minecraft:leaves 3000 4 3000 3010 30 3010 limit 1",
      "devtool find block minecraft:log 3000 4 3000 3010 30 3010 limit 1",
      {
        "command": "fill 3000 4 3000 3010 30 3010 minecraft:air",
        "toleratedFailures": [
          "commands.fill.failed"
        ]
      },
      {
        "command": "devtool find block minecraft:leaves 3000 4 3000 3010 30 3010",
        "delayTicks": 200
      },
      "devtool find block minecraft:log 3000 4 3000 3010 30 3010",
      "devtool find block minecraft:leaves2 3000 4 3000 3010 30 3010",
      "devtool find block minecraft:log2 3000 4 3000 3010 30 3010",
      {
        "command": "devtool await chunks ~176 ~-8 ~208 ~8 20 populated",
        "toleratedFailures": [
          "devtool.wait.timeout"
        ]
      },
      "devtool inspect chunk ~128 ~",
      "devtool inspect chunk ~160 ~",
      "devtool inspect chunk ~176 ~",
      "devtool inspect chunk ~192 ~",
      "devtool inspect chunk ~208 ~",
      "devtool mark V46_POPULATED_END"
    ]
  }
}
